{
	"schemaVersion": 1,
	"id": "essentials",
	"version": "${version}",
	"name": "Essentials",
	"description": "Server-side essentials for Fabric: teleports, homes, warps, TPA, chat, economy, kits, moderation and combat tagging, with a permission node for everything. Vanilla clients can join without installing anything.",
	"authors": [
		"Roorogeo"
	],
	"contact": {
		"sources": "https://github.com/Roorogeo/Tpa-mod",
		"issues": "https://github.com/Roorogeo/Tpa-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/essentials/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"com.roorogeo.essentials.Essentials"
		]
	},
	"mixins": [
		"essentials.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-permissions-api-v0": "*"
	}
}
